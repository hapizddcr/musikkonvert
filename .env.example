# Roblox Open Cloud API Configuration
# Get your API key from: https://create.roblox.com/dashboard/credentials
# Required scopes: asset, asset-delivery
ROBLOX_API_BASE_URL=https://apis.roblox.com

# Maximum file size in bytes (default: 50MB)
NEXT_PUBLIC_MAX_FILE_SIZE=52428800

# Allowed audio formats (comma-separated)
NEXT_PUBLIC_ALLOWED_FORMATS=mp3,wav,ogg,m4a

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# App URL (for Roblox asset URL construction)
NEXT_PUBLIC_APP_URL=http://localhost:3000
